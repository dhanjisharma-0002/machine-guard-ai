# ==============================================================================
# ISAAC Production Environment Configuration Template
# Instructions: Copy to .env in your production container/server.
# DO NOT commit real secrets or production passwords into version control.
# ==============================================================================

# --- Application Runtime ---
APP_NAME="ISAAC Industrial Plant Engine"
APP_ENV=production
API_PREFIX=/api
PORT=8000
HOST=0.0.0.0

# --- Production Database (MySQL / Aurora / Cloud SQL) ---
MYSQL_HOST=mysql-db.internal
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=admin@123
MYSQL_DATABASE=isaac_production
MYSQL_CONNECT_TIMEOUT=5

# --- Security & JWT Authentication ---
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_HEX_SECRET_KEY_AT_LEAST_64_CHARS
AUTH_TOKEN_EXPIRE_MINUTES=480
AUTH_REQUIRED=true
CORS_ALLOWED_ORIGINS=https://isaac.yourplantdomain.com,https://dashboard.yourplantdomain.com
CORS_ORIGIN_REGEX=^https://.*\.vercel\.app$
CORS_ALLOW_CREDENTIALS=true

# --- Industrial Event Streaming (Apache Kafka Cluster) ---
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=kafka-broker-1.internal:9092,kafka-broker-2.internal:9092
KAFKA_TOPIC_TELEMETRY=industrial-sensor-telemetry
KAFKA_TOPIC_PREDICTIONS=industrial-predictions-telemetry
KAFKA_CONSUMER_GROUP=isaac-production-prediction-group
KAFKA_AUTO_OFFSET_RESET=latest
KAFKA_CLIENT_ID=isaac-prod-worker
KAFKA_TIMEOUT_MS=3000
KAFKA_MAX_RETRIES=5
KAFKA_RETRY_BACKOFF_MS=500

# --- Frontend Ingress & Vercel Configuration ---
VITE_API_BASE_URL=https://isaac.yourplantdomain.com
VITE_WS_URL=wss://isaac.yourplantdomain.com/ws/telemetry
