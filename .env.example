# ==============================================================================
# ISAAC Industrial Predictive Maintenance Platform - Environment Configuration
# Copy this file to .env for local development or .env.production for production.
# ==============================================================================

# --- Application Metadata ---
APP_NAME="ISAAC API"
APP_ENV=development
API_PREFIX=/api
PORT=8000
HOST=0.0.0.0

# --- MySQL Relational Database ---
# Leave MYSQL_USER and MYSQL_PASSWORD empty to fallback to SQLite in-memory/local mode
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=admin
MYSQL_PASSWORD=admin@123
MYSQL_DATABASE=isaac
MYSQL_CONNECT_TIMEOUT=5

# --- Security & Authentication (Phase 17) ---
# Set a strong 256-bit secret key in production (e.g. openssl rand -hex 32)
SECRET_KEY=isaac-industrial-secret-key-change-in-production
AUTH_TOKEN_EXPIRE_MINUTES=480
AUTH_REQUIRED=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
CORS_ORIGIN_REGEX=^https://.*\.vercel\.app$
CORS_ALLOW_CREDENTIALS=true

# --- Apache Kafka Industrial Event Streaming (Phase 16) ---
# Set KAFKA_ENABLED=true when Kafka broker is available
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TELEMETRY=industrial-sensor-telemetry
KAFKA_TOPIC_PREDICTIONS=industrial-predictions-telemetry
KAFKA_CONSUMER_GROUP=isaac-prediction-group
KAFKA_AUTO_OFFSET_RESET=latest
KAFKA_CLIENT_ID=isaac-stream-worker
KAFKA_TIMEOUT_MS=2000
KAFKA_MAX_RETRIES=3
KAFKA_RETRY_BACKOFF_MS=500

# --- Frontend & Vercel Deployment Configuration ---
# For local dev: http://localhost:8000
# For Vercel production: Set VITE_API_BASE_URL in Vercel project environment variables
VITE_API_BASE_URL=http://localhost:8000
# Optional WebSocket URL for telemetry stream (auto-derived from VITE_API_BASE_URL if omitted)
VITE_WS_URL=ws://localhost:8000/ws/telemetry
